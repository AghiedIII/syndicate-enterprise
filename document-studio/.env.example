# ============================================================================
# DOCUMENT STUDIO SERVICE — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this to .env and fill in your local values
# ============================================================================

# Service Configuration
SERVICE_PORT=5000
NODE_ENV=development

# Backend API Connection
API_BASE_URL=http://localhost:3000
API_JWT_SECRET=your_super_secret_key_min_32_chars_long_change_me_in_production

# File Output
OUTPUT_DIR=/tmp/syndicate_pdfs
TEMP_DIR=/tmp/syndicate_temp

# Logging
LOG_LEVEL=DEBUG

# PDF Generation
PDF_DPI=300
PDF_COMPRESSION=true

# Regional Assets
ASSETS_DIR=./assets
