# ============================================================================
# BACKEND SERVICE — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this to .env and fill in your local values
# ============================================================================

# Node Environment
NODE_ENV=development
API_PORT=3000

# PostgreSQL Connection (Your DBeaver database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syndicate_ledger_db_0
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=syndicate_ledger_db_0
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_key_min_32_chars_long_change_me_in_production
JWT_EXPIRY=24h

# CORS & Frontend
FRONTEND_URL=http://localhost:5173

# Exchange Rate Configuration
USD_SYP_RATE=15000

# Document Studio Service
DOCUMENT_STUDIO_URL=http://localhost:5000
DOCUMENT_STUDIO_API_KEY=your_document_studio_secret

# Logging
LOG_LEVEL=debug
ENABLE_QUERY_LOGGING=true

# Database Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Timeouts
QUERY_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=30000
