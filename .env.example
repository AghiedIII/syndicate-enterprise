# ============================================================================
# SYNDICATE ENTERPRISE — ROOT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this to .env and fill in your local values
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection (Your Local DBeaver Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syndicate_ledger_db_0

# JWT Authentication
JWT_SECRET=your_super_secret_key_min_32_chars_long_change_me_in_production
JWT_EXPIRY=24h

# Exchange Rate (SYP per USD)
USD_SYP_RATE=15000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Document Studio Service
DOCUMENT_STUDIO_URL=http://localhost:5000

# Logging
LOG_LEVEL=debug
